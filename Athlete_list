#Connect to the database and create the Athlete Table
import sqlite3

connection = sqlite3.connect("Athlete.db")
cursor = connection.cursor()
cursor.execute("""
    CREATE TABLE IF NOT EXISTS athletes(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL UNIQUE,
        gender TEXT NOT NULL,
        weight TEXT NOT NULL,
        age TEXT NOT NULL
    
    )
""")
connection.commit()
#Basic data of the Athletes
WEIGHTS_MALE = [50,55,60,66,73,81,90,100,'+100']
WEIGHTS_FEMALE = [40,44,48,52,57,63,70,78,'+78']
AGE_GROUP = ['Cadet', 'Junior', 'Senior']

def choose_option(options, title):
    print(f"\n{title}")

    for i, option in enumerate(options):
        print(f"{i + 1}. {option}")

    while True:
        choice = int(input("Choose: "))
        if 1 <= choice<= len(options):
            break
        else:
            print(f"Please insert a number from the shown below")
    return options[choice - 1]

num = int(input("How many athletes should be added now?: \n"))


for _ in range(num):
    name = input("Introduce the athlete name: \n")
    while True:
        gender = input("Introduce the athlete gender (M/F): \n")
        gender = gender.upper().strip()
        if gender in ["M","F"]:
            break
        else:
            print("Please enter a valid gender (M/F)")
    if gender == "M":
        weight = choose_option(WEIGHTS_MALE, "Weight categories")

    elif gender == "F":
        weight = choose_option(WEIGHTS_FEMALE, "Weight categories")
    else:
        print("Please enter only M or F")
    age = choose_option(AGE_GROUP, "Age groups")

    cursor.execute( """INSERT INTO athletes
                    (name, gender,weight,age) 
                    VALUES (?,?,?,?)""",
                    (name,gender,weight,age))
connection.commit()
cursor.execute("SELECT * FROM ATHLETES")
athletes = cursor.fetchall()
print(athletes)

connection.close()
